{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-client.dev/schemas/pi-node-runtime-capsule-manifest-v1.json",
  "title": "Pi Node Runtime Capsule Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capsuleKind",
    "sourceCommit",
    "target",
    "versions",
    "locks",
    "runtime",
    "application",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capsuleKind": {
      "const": "pi-node-runtime"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "architecture"],
      "properties": {
        "id": {
          "enum": ["darwin-arm64", "darwin-x64", "linux-x64", "win32-x64"]
        },
        "platform": {
          "enum": ["darwin", "linux", "win32"]
        },
        "architecture": {
          "enum": ["arm64", "x64"]
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["piNode", "protocol", "piSdk", "protobuf", "node", "npm", "bunBuilder"],
      "properties": {
        "piNode": {
          "type": "string",
          "minLength": 1
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "piSdk": {
          "const": "0.84.3"
        },
        "protobuf": {
          "const": "2.14.0"
        },
        "node": {
          "const": "22.19.0"
        },
        "npm": {
          "type": "string",
          "minLength": 1
        },
        "bunBuilder": {
          "const": "1.4.0"
        }
      }
    },
    "locks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sourcePath", "capsulePath", "sha256"],
        "properties": {
          "name": {
            "enum": ["node", "protocol"]
          },
          "sourcePath": {
            "$ref": "#/$defs/relativePath"
          },
          "capsulePath": {
            "$ref": "#/$defs/relativePath"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archiveName",
        "archiveUrl",
        "checksumsUrl",
        "archiveSha256",
        "checksumsSha256",
        "executable",
        "npmCli",
        "licenses"
      ],
      "properties": {
        "archiveName": {
          "type": "string",
          "minLength": 1
        },
        "archiveUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://nodejs\\.org/dist/v22\\.19\\.0/"
        },
        "checksumsUrl": {
          "const": "https://nodejs.org/dist/v22.19.0/SHASUMS256.txt"
        },
        "archiveSha256": {
          "$ref": "#/$defs/sha256"
        },
        "checksumsSha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable": {
          "$ref": "#/$defs/relativePath"
        },
        "npmCli": {
          "$ref": "#/$defs/relativePath"
        },
        "licenses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packagePath", "entrypoint", "protocolPackagePath", "launch"],
      "properties": {
        "packagePath": {
          "const": "app/package.json"
        },
        "entrypoint": {
          "const": "app/dist/stdio-main.js"
        },
        "protocolPackagePath": {
          "const": "app/node_modules/@pi-client/protocol"
        },
        "launch": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "manifestExcludedPath", "payloadFileCount", "payloadSize", "files"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "manifestExcludedPath": {
          "const": "capsule-manifest.json"
        },
        "payloadFileCount": {
          "type": "integer",
          "minimum": 1
        },
        "payloadSize": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/fileEntry"
              },
              {
                "$ref": "#/$defs/symlinkEntry"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "size", "sha256", "executable"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "type": {
          "const": "file"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "symlinkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "target", "size", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "type": {
          "const": "symlink"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
