---
interface Props {
  name: 'sessions' | 'prompt' | 'stream' | 'stop';
}

const { name } = Astro.props;
---

<span class="feature-icon" aria-hidden="true">
  {
    name === 'sessions' && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M5 6.5h14M5 11.5h9M5 16.5h6" />
        <circle cx="18" cy="16.5" r="2.5" />
      </svg>
    )
  }
  {
    name === 'prompt' && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="m5 7 5 5-5 5M12 17h7" />
      </svg>
    )
  }
  {
    name === 'stream' && (
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="12" cy="12" r="2" />
        <path d="M7.8 7.8a6 6 0 0 0 0 8.4M16.2 7.8a6 6 0 0 1 0 8.4M4.5 4.5a10.6 10.6 0 0 0 0 15M19.5 4.5a10.6 10.6 0 0 1 0 15" />
      </svg>
    )
  }
  {
    name === 'stop' && (
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="6.5" y="6.5" width="11" height="11" rx="2" />
      </svg>
    )
  }
</span>

<style>
  .feature-icon {
    align-items: center;
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 14px;
    color: var(--accent-light);
    display: inline-flex;
    height: 46px;
    justify-content: center;
    width: 46px;
  }

  svg {
    height: 24px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    width: 24px;
  }
</style>
