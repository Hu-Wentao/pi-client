---
import type { PrincipleIcon } from '../content/copy';

interface Props {
  name: PrincipleIcon;
}

const { name } = Astro.props;
---

<span class="feature-icon" aria-hidden="true">
  {
    name === 'code' && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="m8.5 7-5 5 5 5M15.5 7l5 5-5 5M13.5 4l-3 16" />
      </svg>
    )
  }
  {
    name === 'platforms' && (
      <svg viewBox="0 0 24 24" fill="none">
        <rect x="3" y="4" width="12" height="9" rx="1.5" />
        <path d="M7 18h4M9 13v5" />
        <rect x="17" y="8" width="4" height="9" rx="1" />
      </svg>
    )
  }
  {
    name === 'roles' && (
      <svg viewBox="0 0 24 24" fill="none">
        <circle cx="7" cy="12" r="3" />
        <circle cx="17" cy="7" r="3" />
        <circle cx="17" cy="17" r="3" />
        <path d="m9.5 10.5 5-2M9.5 13.5l5 2" />
      </svg>
    )
  }
  {
    name === 'open' && (
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M8 18.5H5.5A2.5 2.5 0 0 1 3 16V6.5A2.5 2.5 0 0 1 5.5 4H15a2.5 2.5 0 0 1 2.5 2.5V9" />
        <path d="M13 15h8M17 11l4 4-4 4" />
      </svg>
    )
  }
</span>

<style>
  .feature-icon {
    align-items: center;
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 14px;
    color: var(--accent-light);
    display: inline-flex;
    height: 46px;
    justify-content: center;
    width: 46px;
  }

  svg {
    height: 24px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    width: 24px;
  }
</style>
