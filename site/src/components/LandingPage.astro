---
import type { LandingCopy } from '../content/copy';
import { release } from '../content/copy';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureIcon from './FeatureIcon.astro';

interface Props {
  copy: LandingCopy;
  canonicalPath: string;
}

const { copy, canonicalPath } = Astro.props;
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
const markUrl = withBase('assets/pi-client-mark.svg');
const screenshotUrl = withBase('assets/workspace-preview.png');
const languageUrl = withBase(copy.languageHref);
const repositoryUrl = 'https://github.com/Hu-Wentao/pi-client';
const issuesUrl = `${repositoryUrl}/issues`;
const readmeUrl = `${repositoryUrl}#start-pi-client`;
const contributingUrl = `${repositoryUrl}/blob/main/CONTRIBUTING.md`;
const licenseUrl = `${repositoryUrl}/blob/main/LICENSE`;
const skipLabel = copy.locale === 'zh-cn' ? '跳到主要内容' : 'Skip to content';
---

<BaseLayout
  lang={copy.htmlLang}
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
  skipLabel={skipLabel}
  socialImageAlt={copy.socialImageAlt}
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href={withBase(copy.locale === 'en' ? '/' : '/zh-cn/')} aria-label={copy.homeLabel}>
        <img src={markUrl} alt="" width="34" height="34" />
        <span>Pi Client</span>
      </a>
      <nav class="primary-nav" aria-label={copy.navigationLabel}>
        <a href="#features">{copy.nav.features}</a>
        <a href="#workflow">{copy.nav.workflow}</a>
        <a href="#security">{copy.nav.security}</a>
        <a href={repositoryUrl}>{copy.nav.github}</a>
      </nav>
      <a class="language-link" href={languageUrl} hreflang={copy.locale === 'en' ? 'zh-CN' : 'en'}>
        <span class="sr-only">{copy.languageLabel}: </span>{copy.languageName}
      </a>
    </div>
  </header>

  <main id="main">
    <section class="hero section-shell">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1>{copy.hero.title}</h1>
          <p class="hero-description">{copy.hero.description}</p>
          <ul class="badge-list" aria-label={copy.releaseDetailsLabel}>
            {copy.hero.badges.map((badge) => <li>{badge}</li>)}
          </ul>
          <div class="cta-row">
            <a class="button button-primary" href={release.downloadUrl}>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" /></svg>
              {copy.hero.download}
            </a>
            <a class="button button-secondary" href={repositoryUrl}>
              {copy.hero.source}
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
            </a>
          </div>
          <p class="release-note">{copy.hero.releaseNote}</p>
        </div>
        <div class="hero-brand" aria-hidden="true">
          <img src={markUrl} alt="" width="360" height="360" />
          <span class="orbit orbit-one"></span>
          <span class="orbit orbit-two"></span>
        </div>
      </div>
      <div class="container screenshot-wrap">
        <div class="window-frame">
          <div class="window-toolbar" aria-hidden="true">
            <span class="window-dot dot-red"></span>
            <span class="window-dot dot-yellow"></span>
            <span class="window-dot dot-green"></span>
            <span class="window-title">Pi Client</span>
          </div>
          <img src={screenshotUrl} alt={copy.screenshotAlt} width="1280" height="800" loading="eager" />
        </div>
        <p class="screenshot-caption">{copy.screenshotCaption}</p>
      </div>
    </section>

    <aside class="warning-band" aria-labelledby="preview-warning-title">
      <div class="container warning-inner">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 2.8 20h18.4L12 3Z" /><path d="M12 9v5m0 3h.01" /></svg>
        <div>
          <h2 id="preview-warning-title">{copy.warning.title}</h2>
          <p>{copy.warning.body}</p>
        </div>
      </div>
    </aside>

    <section id="features" class="content-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">{copy.features.eyebrow}</p>
          <h2>{copy.features.title}</h2>
          <p>{copy.features.description}</p>
        </div>
        <div class="feature-grid">
          {copy.features.items.map((feature) => (
            <article class="feature-card">
              <FeatureIcon name={feature.icon} />
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="workflow" class="content-section workflow-section">
      <div class="container workflow-grid">
        <div class="section-heading workflow-copy">
          <p class="eyebrow">{copy.workflow.eyebrow}</p>
          <h2>{copy.workflow.title}</h2>
          <p>{copy.workflow.description}</p>
          <p class="transition-note">{copy.workflow.transitional}</p>
        </div>
        <div class="architecture-card" role="img" aria-label={`${copy.workflow.client}, ${copy.workflow.bridge}, ${copy.workflow.runtime}`}>
          <div class="architecture-node node-client">
            <img src={markUrl} alt="" width="44" height="44" />
            <span>{copy.workflow.client}</span>
            <small>macOS</small>
          </div>
          <div class="architecture-connector">
            <span>HTTP / SSE</span>
            <svg aria-hidden="true" viewBox="0 0 120 16"><path d="M2 8h112m-7-6 7 6-7 6" /></svg>
          </div>
          <div class="architecture-node">
            <span>{copy.workflow.bridge}</span>
            <small>transitional</small>
          </div>
          <div class="architecture-connector">
            <span>runtime</span>
            <svg aria-hidden="true" viewBox="0 0 120 16"><path d="M2 8h112m-7-6 7 6-7 6" /></svg>
          </div>
          <div class="architecture-node">
            <span>{copy.workflow.runtime}</span>
            <small>sessions · models · tools</small>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section start-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">{copy.start.eyebrow}</p>
          <h2>{copy.start.title}</h2>
          <p>{copy.start.description}</p>
        </div>
        <ol class="step-grid">
          {copy.start.steps.map((step) => (
            <li>
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>
                {step.description.split('`').map((part, index) =>
                  index % 2 === 1 ? <code>{part}</code> : part,
                )}
              </p>
            </li>
          ))}
        </ol>
        <a class="text-link" href={readmeUrl}>
          {copy.start.fullGuide}
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
        </a>
      </div>
    </section>

    <section id="security" class="content-section security-section">
      <div class="container security-grid">
        <div class="section-heading">
          <p class="eyebrow">{copy.security.eyebrow}</p>
          <h2>{copy.security.title}</h2>
          <p>{copy.security.description}</p>
        </div>
        <ul class="check-list">
          {copy.security.points.map((point) => (
            <li>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4 10-10" /></svg>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="container limitations-card">
        <h3>{copy.limitations.title}</h3>
        <ul>
          {copy.limitations.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-card">
        <div>
          <h2>{copy.closing.title}</h2>
          <p>{copy.closing.description}</p>
        </div>
        <div class="cta-row">
          <a class="button button-primary" href={release.downloadUrl}>{copy.closing.download}</a>
          <a class="button button-secondary" href={issuesUrl}>{copy.closing.issues}</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-grid">
      <div class="footer-brand">
        <div class="brand">
          <img src={markUrl} alt="" width="32" height="32" />
          <span>Pi Client</span>
        </div>
        <p>{copy.footer.description}</p>
      </div>
      <nav aria-label={copy.projectLinksLabel}>
        <a href={readmeUrl}>{copy.footer.readme}</a>
        <a href={contributingUrl}>{copy.footer.contributing}</a>
        <a href={licenseUrl}>{copy.footer.license}</a>
        <a href={issuesUrl}>{copy.footer.issues}</a>
      </nav>
      <p class="footer-attribution">{copy.footer.attribution}</p>
    </div>
  </footer>
</BaseLayout>
