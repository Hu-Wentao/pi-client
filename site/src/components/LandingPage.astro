---
import type { LandingCopy } from '../content/copy';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureIcon from './FeatureIcon.astro';

interface Props {
  copy: LandingCopy;
  canonicalPath: string;
}

const { copy, canonicalPath } = Astro.props;
const withBase = (path: string) =>
  `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
const markUrl = withBase('assets/pi-client-mark.svg');
const languageUrl = withBase(copy.languageHref);
const repositoryUrl = 'https://github.com/Hu-Wentao/pi-client';
const issuesUrl = `${repositoryUrl}/issues`;
const readmeUrl = `${repositoryUrl}#project-status`;
const contributingUrl = `${repositoryUrl}/blob/main/CONTRIBUTING.md`;
const licenseUrl = `${repositoryUrl}/blob/main/LICENSE`;
const skipLabel = copy.locale === 'zh-cn' ? '跳到主要内容' : 'Skip to content';
const platforms = ['Android', 'iOS', 'macOS', 'Windows', 'Linux', 'Web'];
---

<BaseLayout
  lang={copy.htmlLang}
  title={copy.metaTitle}
  description={copy.metaDescription}
  canonicalPath={canonicalPath}
  skipLabel={skipLabel}
  socialImageAlt={copy.socialImageAlt}
>
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href={withBase(copy.locale === 'en' ? '/' : '/zh-cn/')} aria-label={copy.homeLabel}>
        <img src={markUrl} alt="" width="34" height="34" />
        <span>Pi Client</span>
      </a>
      <nav class="primary-nav" aria-label={copy.navigationLabel}>
        <a href="#product">{copy.nav.product}</a>
        <a href="#platforms">{copy.nav.platforms}</a>
        <a href="#status">{copy.nav.status}</a>
        <a href={repositoryUrl}>{copy.nav.github}</a>
      </nav>
      <a class="language-link" href={languageUrl} hreflang={copy.locale === 'en' ? 'zh-CN' : 'en'}>
        <span class="sr-only">{copy.languageLabel}: </span>{copy.languageName}
      </a>
    </div>
  </header>

  <main id="main">
    <section class="hero section-shell">
      <div class="hero-glow hero-glow-one"></div>
      <div class="hero-glow hero-glow-two"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1>{copy.hero.title}</h1>
          <p class="hero-description">{copy.hero.description}</p>
          <ul class="badge-list" aria-label={copy.hero.platformLabel}>
            {copy.hero.badges.map((badge) => <li>{badge}</li>)}
          </ul>
          <div class="cta-row">
            <a class="button button-primary" href={repositoryUrl}>
              {copy.hero.primary}
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg>
            </a>
            <a class="button button-secondary" href={contributingUrl}>
              {copy.hero.secondary}
            </a>
          </div>
          <p class="development-note">
            <span aria-hidden="true"></span>
            {copy.hero.note}
          </p>
        </div>
        <div class="platform-visual" aria-label={copy.hero.platformLabel} role="img">
          <div class="platform-core">
            <img src={markUrl} alt="" width="148" height="148" />
            <strong>Pi Client</strong>
            <span>Flutter</span>
          </div>
          <div class="platform-ring">
            {platforms.map((platform, index) => (
              <span class={`platform-chip platform-chip-${index + 1}`}>{platform}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="product" class="content-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">{copy.principles.eyebrow}</p>
          <h2>{copy.principles.title}</h2>
          <p>{copy.principles.description}</p>
        </div>
        <div class="feature-grid">
          {copy.principles.items.map((principle) => (
            <article class="feature-card">
              <FeatureIcon name={principle.icon} />
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="platforms" class="content-section roles-section">
      <div class="container roles-layout">
        <div class="section-heading roles-copy">
          <p class="eyebrow">{copy.roles.eyebrow}</p>
          <h2>{copy.roles.title}</h2>
          <p>{copy.roles.description}</p>
          <p class="boundary-note">{copy.roles.note}</p>
        </div>
        <div class="role-grid">
          <article class="role-card role-card-desktop">
            <span class="role-badge">{copy.roles.desktop.badge}</span>
            <h3>{copy.roles.desktop.title}</h3>
            <p class="role-platforms">{copy.roles.desktop.platforms}</p>
            <p>{copy.roles.desktop.description}</p>
          </article>
          <article class="role-card">
            <span class="role-badge role-badge-connect">{copy.roles.connectOnly.badge}</span>
            <h3>{copy.roles.connectOnly.title}</h3>
            <p class="role-platforms">{copy.roles.connectOnly.platforms}</p>
            <p>{copy.roles.connectOnly.description}</p>
          </article>
        </div>
      </div>
    </section>

    <section id="status" class="content-section status-section">
      <div class="container status-layout">
        <div class="section-heading">
          <p class="eyebrow">{copy.status.eyebrow}</p>
          <h2>{copy.status.title}</h2>
          <p>{copy.status.description}</p>
        </div>
        <ul class="status-list">
          {copy.status.items.map((item) => (
            <li>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 12 4 4 10-10" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
        <aside class="status-notice">
          <span class="status-indicator" aria-hidden="true"></span>
          <div>
            <h3>{copy.status.noticeTitle}</h3>
            <p>{copy.status.noticeBody}</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="closing-section">
      <div class="container closing-card">
        <div>
          <h2>{copy.closing.title}</h2>
          <p>{copy.closing.description}</p>
        </div>
        <div class="cta-row">
          <a class="button button-primary" href={repositoryUrl}>{copy.closing.source}</a>
          <a class="button button-secondary" href={contributingUrl}>{copy.closing.contribute}</a>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="container footer-grid">
      <div class="footer-brand">
        <div class="brand">
          <img src={markUrl} alt="" width="32" height="32" />
          <span>Pi Client</span>
        </div>
        <p>{copy.footer.description}</p>
      </div>
      <nav aria-label={copy.projectLinksLabel}>
        <a href={readmeUrl}>{copy.footer.readme}</a>
        <a href={contributingUrl}>{copy.footer.contributing}</a>
        <a href={licenseUrl}>{copy.footer.license}</a>
        <a href={issuesUrl}>{copy.footer.issues}</a>
      </nav>
      <p class="footer-attribution">{copy.footer.attribution}</p>
    </div>
  </footer>
</BaseLayout>
