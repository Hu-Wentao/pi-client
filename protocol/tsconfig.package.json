{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["gen/ts/**/*.ts", "src/**/*.ts"]
}
